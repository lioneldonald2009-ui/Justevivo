{
  "name": "justevivo-ai",
  "version": "1.0.0",
  "private": true,
  "description": "JUSTEVIVO AI multiplatform video creation studio",
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs",
    "cap:sync": "npm run build:web && cap sync",
    "cap:sync:android": "npm run build:web && cap sync android",
    "cap:sync:ios": "npm run build:web && cap sync ios",
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "android:build:debug": "npm run build:web && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:build:simulator": "npm run build:web && cap sync ios",
    "desktop:dev": "npm run build:web && electron .",
    "desktop:dist": "npm run build:web && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/assets": "^3.0.5",
    "typescript": "^5.9.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop-main.cjs",
  "build": {
    "appId": "com.justevivo.ai",
    "productName": "JUSTEVIVO AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop-main.cjs",
      "desktop-preload.cjs",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JUSTEVIVO-AI-${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "JUSTEVIVO-AI-Portable-${version}.${ext}"
    }
  }
}
